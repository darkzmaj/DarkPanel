{
  "manifest_version": 3,
  "name": "DarkPanel",
  "version": "1.0.0",
  "description": "Per-site popup and redirect blocking, site permissions and an extensions list in one panel.",
  "key": "",
  "minimum_chrome_version": "122",
  "incognito": "spanning",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "declarativeNetRequest",
    "contentSettings",
    "cookies",
    "browsingData",
    "management"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DarkPanel",
    "default_popup": "ui/guard.html"
  },
  "options_ui": {
    "page": "ui/guard.html#guard",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://darkzmaj.eu/"
}
